# ============================================================
# HAIR BY MAEVA — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your values
# ============================================================

# 1. Supabase Cloud Database (Free at https://supabase.com)
# Connects bookings and services across all devices & phones
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 2. Resend Email Notifications (Free at https://resend.com - 3,000 emails/mo)
# Sends instant appointment alerts to Awa Diongue's email
RESEND_API_KEY=re_your_resend_api_key_here

# 3. Destination Notification Email (Default: Maevausa@outlook.com)
SALON_NOTIFICATION_EMAIL=Maevausa@outlook.com
